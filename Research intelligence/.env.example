# ── OAU Thesis Bank — Phase 3 (AI Intelligence) ──────────────────────────
# Copy to .env and fill in real values. Never commit the populated file.

# ── Environment ───────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO
SERVICE_NAME=oau-thesis-bank-ai

# ── Existing Phase 2 backend integration ─────────────────────────────────
# Fill these in once Phase 1/2 have been inspected — do not guess values.
BACKEND_API_BASE_URL=
BACKEND_API_INTERNAL_TOKEN=
AUTH_JWKS_URL=
AUTH_ISSUER=

# ── PostgreSQL + pgvector ─────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=oau_thesis_bank
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=prefer
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Redis (job queue, rate limiting, caching) ─────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── Object storage (MinIO / Cloudflare R2 — S3-compatible) ───────────────
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET_DOCUMENTS=oau-thesis-documents
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_USE_SSL=true

# ── Document processing (3.1) ─────────────────────────────────────────────
LAYOUTLM_MODEL_NAME=microsoft/layoutlmv3-base
PADDLEOCR_LANG=en
CHUNK_TOKEN_SIZE=512
CHUNK_TOKEN_OVERLAP=50

# ── Embeddings (3.2) ───────────────────────────────────────────────────────
EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5
EMBEDDING_MODEL_VERSION=stock-v1
EMBEDDING_DIM=1024
EMBEDDING_INFERENCE_DEVICE=auto      # auto | cpu | cuda

# ── Retrieval / reranking (3.3) ───────────────────────────────────────────
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANKER_MODEL_VERSION=stock-v1
HYBRID_TOP_K_CANDIDATES=50
HYBRID_TOP_K_FINAL=20

# ── RAG / guardrails (3.4) ─────────────────────────────────────────────────
PROMPT_GUARD_MODEL_NAME=meta-llama/Llama-Prompt-Guard-2-86M
LLAMA_GUARD_MODEL_NAME=meta-llama/Llama-Guard-3-8B
LLM_INFERENCE_PROVIDER=              # e.g. bedrock | together | self-hosted
LLM_INFERENCE_ENDPOINT=
LLM_INFERENCE_API_KEY=
LLM_MODEL_NAME=

# ── Research intelligence (3.5 / 3.5B) ────────────────────────────────────
GAP_ENGINE_MODEL_VERSION=unfit
PLAGIARISM_LEXICAL_WEIGHT=0.35
PLAGIARISM_SEMANTIC_WEIGHT=0.65
PLAGIARISM_REVIEW_THRESHOLD=0.80

# ── Recommendation (3.9) ───────────────────────────────────────────────────
RECOMMENDATION_STRATEGY=baseline     # baseline | lightfm | implicit

# ── Security (3.10) ────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
WATERMARK_SECRET_KEY=

# ── Telemetry (3.12) ───────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
