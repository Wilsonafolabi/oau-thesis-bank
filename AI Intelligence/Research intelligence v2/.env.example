# ============================================================
# OAU Thesis Bank — Phase 3 Research Intelligence (V2)
# ============================================================
# Copy to .env and fill in real values. Never commit the populated file.
# Secrets are never stored in source code.

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SERVICE_NAME=oau-thesis-bank-ai-v2

# Existing Phase 1/2 backend integration
# Fill these in once Phase 1/2 have been inspected — do not guess values.
BACKEND_API_BASE_URL=
BACKEND_API_INTERNAL_TOKEN=
AUTH_JWKS_URL=
AUTH_ISSUER=

# PostgreSQL + pgvector — Phase 3
# V2 prefers RI_DATABASE_URL. If it is empty, the app assembles a connection
# URL from the POSTGRES_* components below. Tables are created automatically
# at startup under the ai_intelligence schema.
RI_DATABASE_URL=

# Component form — used as a fallback when RI_DATABASE_URL is empty.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=oau_thesis_bank
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=prefer

# Redis (job queue, rate limiting, caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Object storage — MinIO / Cloudflare R2 (S3-compatible)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET_DOCUMENTS=oau-thesis-documents
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_USE_SSL=true

# Cloudflare Vectorize (vector index — user decision)
VECTORIZE_API_TOKEN=
VECTORIZE_ACCOUNT_ID=
VECTORIZE_INDEX_NAME=oau-thesis-chunks
VECTORIZE_DIMENSIONS=1024

# Document processing
CHUNK_TOKEN_SIZE=512
CHUNK_TOKEN_OVERLAP=50

# Embeddings
EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5
EMBEDDING_MODEL_VERSION=stock-v1
EMBEDDING_DIM=1024

# Retrieval / reranking
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANKER_MODEL_VERSION=stock-v1
HYBRID_TOP_K_CANDIDATES=50
HYBRID_TOP_K_FINAL=20

# Shared LLM provider configuration
# DeepSeek is the designated primary reasoning/generation provider.
# Groq is available for explicitly designated smaller tasks only.
# No automatic provider fallback.
LLM_PRIMARY_PROVIDER=deepseek
LLM_FALLBACK_ORDER=deepseek
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=1.5
LLM_HEALTH_TTL_SECONDS=30

# DeepSeek (primary reasoning/generation). Set only in local .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Groq (designated smaller tasks only — not automatic fallback).
# Set only in local .env.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# JEV (System One decision layer — full decision-making/security scope)
# Leave empty unless actually used.
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1

# Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
